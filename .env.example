# =================================================================
# Picsee Frontend - Environment Configuration
# =================================================================

# Backend REST API Base URL (must end with trailing slash)
VITE_API_URL=http://localhost:8000/api/v1/

# AES Secret Key for password reset token decryption (must match backend SECRET_ENCRYPT)
VITE_SECRET_HASH=your_aes_encryption_secret_key

# Google OAuth2 Client ID for web sign-in
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional default API access token (if configured)
VITE_API_ACCESS_TOKEN=
